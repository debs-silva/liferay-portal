@component-name = "portal-document-management"
definition {

	property testray.main.component.name = "Document Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task ("Create a page") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");
		}

		task ("Add a DM widget on the page") {
			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Documents and Media Page",
				widgetName = "Documents and Media");
		}

		task ("Go the page that was created") {
			Navigator.gotoPage(pageName = "Documents and Media Page");
		}

		task ("Upload DMTest1") {
			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DMTest1 Description",
				dmDocumentTitle = "DMTest1",
				groupName = "Guest",
				mimeType = "application/pdf",
				sourceFileName = "Document_1.pdf");

			JSONDocument.addFileWithUploadedFile(
				dmDocumentDescription = "DMTest2 Description",
				dmDocumentTitle = "DMTest2",
				groupName = "Guest",
				mimeType = "image/jpeg",
				sourceFileName = "Commerce_Black.jpg");
		}
	}

	tearDown {
		task ("Delete the other DM that was uploaded") {
			JSONDocument.moveToRecycleBin(
				dmDocumentTitle = "DMTest2",
				groupName = "Guest");
		}

		task ("Delete the 'Documents and Media Page' page that was created") {
			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Documents and Media Page");
		}

		task ("Log out") {
			User.logoutPG();
		}
	}

	@description = "Can Delete a Documents and Media"
	@priority = "5"
	test CanDeleteDM {
		task ("Go to Documents and Media") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Documents and Media");
		}

		task ("Delete DMTest1") {
			DMDocument.deleteCP(dmDocumentTitle = "DMTest1");
		}

		task ("Go the page that was created") {
			Navigator.gotoPage(pageName = "Documents and Media Page");
		}

		task ("Assert if the file was deleted") {
			DMDocument.cannotViewCP(dmDocumentTitle = "DMTest1");
		}

		task ("Assert if the other file was not deleted") {
			DMDocument.viewPG(dmDocumentTitle = "DMTest2");
		}
	}

}