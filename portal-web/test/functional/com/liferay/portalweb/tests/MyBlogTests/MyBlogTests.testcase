@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		task("Create a page"){
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Page Name");
		}

		task("Add a Blogs widget on the page"){
			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Page Name",
				widgetName = "Blogs");
		}

		task("Create a entry"){
			Navigator.gotoPage(pageName = "Page Name");
			
			Blogs.addEntry(
			entryContent = "Blogs Entry Content",
			entrySubtitle = "Blogs Entry Subtitle",
			entryTitle = "Blogs Entry 1");
		}
	}

	tearDown {
		task("Delete the entries"){
			BlogsEntry.tearDownCP();
		}

		task("Go to the portlet Pages and delete the page that was created"){
			ProductMenu.gotoPortlet(
				category = "Site Builder",
				portlet = "Pages");

			PagesAdmin.deletePage(pageName = "Page Name");
		}

		task("Log out"){
			User.logoutPG();
		}

	}

	@description = "Can Create a Blog"
	@priority = "5"
	test CanCreateBlog {
		task ("Assert the success message") {
			Alert.viewSuccessMessage();
		}

		task ("Assert the entry insertion") {
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry 1");
		}
	}

	@description = "Can Delete a Blog"
	@priority = "5"
	test CanDeleteBlog {

		task("Create a new entry") {
			Blogs.addEntry(
				entryContent = "Blogs Content 2",
				entrySubtitle = "Blogs Subtitle 2",
				entryTitle = "Blogs Entry 2");
		}

		task ("Move a entry to the recycle bin") {
			BlogsEntry.moveToRecycleBinPG(
				assetType = "Blogs Entry",
				entryContent = "Blogs Content 2",
				entryTitle = "Blogs Entry 2",
				entrySubtitle = "Blogs Subtitle 2");
		}

		task("Assert if the other entry was not deleted"){
			BlogsEntry.viewEntryPG(
				entryContent = "Blogs Entry Content",
				entryTitle = "Blogs Entry 1");
		}
	}

	@description = "Can Edit a Blog"
	@priority = "5"
	test CanEditBlog {
		task ("Edit blogs entry content, title and subtitle") {
			Blogs.editEntryPG(
				entryContent = "Blogs Entry Content",
				entryContentEdit = "Blogs Entry Content Edit",
				entrySubtitle = "Blogs Entry Subtitle",
				entrySubtitleEdit = "Blogs Entry Subtitle Edit",
				entryTitle = "Blogs Entry Test",
				entryTitleEdit = "Blogs Entry Test Edit");
		}
	}

	@description = "Can Search Blogs"
	@priority = "5"
	test CanSearchBlogs {
	}

}